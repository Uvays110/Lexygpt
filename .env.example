# Публичный адрес сайта (для canonical и sitemap). На Vercel можно не указывать — возьмётся домен проекта.
NEXT_PUBLIC_SITE_URL=https://example.com

# Ключ fal.ai для реальной генерации. Без ключа сайт работает в демо-режиме.
# ВНИМАНИЕ: перед включением добавьте авторизацию и баланс пользователей,
# иначе любой посетитель сможет тратить ваши кредиты.
FAL_KEY=

# Лимит запросов на генерацию с одного IP в час (только в реальном режиме)
GENERATION_RATE_LIMIT_PER_HOUR=20
